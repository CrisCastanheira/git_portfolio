# URL pública HTTPS deste site. Sem ela, o sitemap permanece vazio para evitar domínio inventado.
SITE_URL=

# Token mantido exclusivamente no servidor, limitado à leitura de contribuições públicas no GraphQL.
GITHUB_TOKEN=

# Necessários para persistir snapshots em produção com Upstash Redis REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Segredo bearer usado somente pela rota agendada /api/cron/sync.
CRON_SECRET=
